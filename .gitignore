# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.turbo/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# editors
/.idea/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets; keep the documented example)
.env*
!.env.example

# local Messimo data (operation history, SQLite databases, test output).
# The history folder keeps its original name so existing records and undo
# continue to work after the rebrand.
/.slothsort/
/data/
# generated demo folders; keep the tracked demo README
/demo/*
!/demo/README.md
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
