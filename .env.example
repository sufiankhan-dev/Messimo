# Copy this file to .env.local and adjust if your local setup differs.

# Ollama must run on this machine. A non-loopback value is refused before any
# prompt is sent, and there is no cloud fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional. Where the local operation history lives. The default is
# ~/.slothsort/history.json. Keep this on the same computer.
# SLOTHSORT_HISTORY_DIR=
